# ── Root-level variables (none required at root level) ────────────────────────
# See server/.env.example and client/.env.example for full lists.

# ── Server (server/.env) ──────────────────────────────────────────────────────
PORT=5000
MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/auth_db
JWT_SECRET=<your-super-secret-32+-char-random-string>
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173
NODE_ENV=development

# ── Client (client/.env) ──────────────────────────────────────────────────────
VITE_API_URL=http://localhost:5000/api
