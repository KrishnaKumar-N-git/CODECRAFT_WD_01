# ── Root-level variables (none required at root level) ────────────────────────
# See server/.env.example and client/.env.example for full lists.

# ── Server (server/.env) ──────────────────────────────────────────────────────
PORT=5000
# 👇 Use MongoDB Atlas URI for cloud deployment (NOT localhost)
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/auth_db?retryWrites=true&w=majority
JWT_SECRET=<your-super-secret-32+-char-random-string>
JWT_EXPIRES_IN=7d
# 👇 Set to your Vercel frontend URL in production
CLIENT_URL=https://your-app.vercel.app
NODE_ENV=production

# ── Client (client/.env) ──────────────────────────────────────────────────────
# 👇 Set to your Render backend URL in production
VITE_API_URL=https://your-auth-server.onrender.com/api
